// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String?   @unique
  password           String?
  avatarUrl          String?
  isGuest            Boolean   @default(false)
  guestExpiresAt     DateTime?
  googleId           String?   @unique
  githubId           String?   @unique
  role               String    @default("user")
  blocked            Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subjects         Subject[]
  reviews          Review[]
  plan             Plan?
  settings         Settings?
  dailyLogs        DailyLog[]
  dayPlanConfigs   DayPlanConfig[]
  studySessions    StudySession[]
  ownedGroups      Group[]         @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]
  notes            Note[]
  tags             Tag[]
  flashcards       Flashcard[]

  @@index([isGuest, guestExpiresAt])
  @@map("users")
}

model Subject {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  color                 String
  priority              Int
  goal                  String
  totalLessons          Int?
  completedLessons      Int      @default(0)
  preferredDays         String[] @default([])
  imageUrl              String?
  reviewCount           Int      @default(3)
  reviewDurationMinutes Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@map("subjects")
}

model Plan {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective    String   @default("")
  availability Json
  schedule     Json?
  weekStart    String?
  studyConfig  Json?
  reviewConfig Json?
  updatedAt    DateTime @updatedAt

  @@map("plans")
}

model Review {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  sourceTaskId    String
  intervalDays    Int
  dueDate         String
  durationMinutes Int      @default(30)
  completed       Boolean  @default(false)
  notified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("reviews")
}

model DayPlanConfig {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday      String
  category     String
  subjectCount Int            @default(0)
  entries      DayPlanEntry[]
  updatedAt    DateTime       @updatedAt

  @@unique([userId, weekday, category])
  @@map("day_plan_configs")
}

model DayPlanEntry {
  id              String        @id @default(uuid())
  dayConfigId     String
  dayConfig       DayPlanConfig @relation(fields: [dayConfigId], references: [id], onDelete: Cascade)
  subjectId       String
  durationMinutes Int
  repetitions     Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([dayConfigId, subjectId])
  @@index([subjectId])
  @@map("day_plan_entries")
}

model StudySession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  category        String
  weekday         String
  weekStart       String
  durationMinutes Int
  sequence        Int       @default(1)
  position        Int       @default(0)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, weekStart, weekday, category, subjectId, sequence])
  @@index([userId, weekStart])
  @@map("study_sessions")
}

model Settings {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                   String    @default("dark")
  defaultDurationMinutes  Int       @default(25)
  defaultBreakMinutes     Int       @default(15)
  notifyOnComplete        Boolean   @default(false)
  dailyGoalPomodoros      Int       @default(4)
  xp                      Int       @default(0)
  totalPomodoros          Int       @default(0)
  totalTasksCompleted     Int       @default(0)
  totalReviewsCompleted   Int       @default(0)
  awardedTaskIds          String[]  @default([])
  awardedReviewIds        String[]  @default([])
  challengeStartDate      DateTime  @default(now())
  currentStreak           Int       @default(0)
  longestStreak           Int       @default(0)
  lastActiveDate          String?
  totalFocusMinutes       Int       @default(0)
  lastPomodoroAwardAt     DateTime?
  pomodoroSoundsEnabled   Boolean   @default(true)
  pomodoroSoundVolume     Int       @default(70)
  pomodoroFocusStartSound String    @default("sino")
  pomodoroFocusEndSound   String    @default("classico")
  pomodoroBreakStartSound String    @default("suave")
  pomodoroBreakEndSound   String    @default("digital")
  updatedAt               DateTime  @updatedAt

  @@map("settings")
}

model DailyLog {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  minutes   Int    @default(0)
  pomodoros Int    @default(0)

  @@unique([userId, date])
  @@map("daily_logs")
}

model Group {
  id          String         @id @default(uuid())
  name        String
  description String?
  icon        String
  type        String         @default("private")
  maxMembers  Int            @default(20)
  inviteCode  String         @unique
  ownerId     String
  owner       User           @relation("GroupOwner", fields: [ownerId], references: [id])
  members     GroupMember[]
  messages    GroupMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id         String    @id @default(uuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("group_messages")
}

model RequestLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  method       String
  endpoint     String
  statusCode   Int
  durationMs   Int
  userId       String?
  targetUserId String?
  eventType    String
  message      String?
  ip           String?
  userAgent    String?
  browser      String?
  os           String?

  @@index([createdAt])
  @@index([userId])
  @@index([eventType])
  @@map("request_logs")
}

model ErrorLog {
  id              String   @id @default(uuid())
  fingerprint     String   @unique
  message         String
  stack           String?
  endpoint        String?
  method          String?
  userId          String?
  severity        String   @default("error")
  environment     String   @default("development")
  occurrenceCount Int      @default(1)
  payload         Json?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([lastSeenAt])
  @@map("error_logs")
}

model HealthSnapshot {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  dbStatus    String
  dbLatencyMs Int?
  cpuPercent  Float
  memoryRssMb Float

  @@index([createdAt])
  @@map("health_snapshots")
}

model Alert {
  id          String    @id @default(uuid())
  type        String
  severity    String    @default("warning")
  message     String
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([type, resolvedAt])
  @@map("alerts")
}

model Note {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String   @default("")
  // Bare id, no FK — same convention as Review/DayPlanEntry/StudySession's
  // subjectId, so a subject can be deleted without an FK constraint error;
  // SubjectsService.remove() nulls this out manually instead of cascading,
  // since notes are durable knowledge that should outlive the subject tag.
  subjectId  String?
  isFavorite Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tags          NoteTag[]
  outboundLinks NoteLink[]  @relation("SourceNote")
  inboundLinks  NoteLink[]  @relation("TargetNote")
  flashcards    Flashcard[]

  @@index([userId])
  @@index([userId, subjectId])
  @@map("notes")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  notes      NoteTag[]
  flashcards FlashcardTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

model NoteLink {
  id           String   @id @default(uuid())
  sourceNoteId String
  sourceNote   Note     @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId String
  targetNote   Note     @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([sourceNoteId, targetNoteId])
  @@index([targetNoteId])
  @@map("note_links")
}

model Flashcard {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  front  String
  back   String
  // Real FK (unlike subjectId below) — Note and Flashcard belong to the same
  // feature/transaction boundary, so there's no cross-module cleanup problem
  // that would justify the bare-id pattern used for Subject references.
  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  // Bare id, no FK — same convention/rationale as Note.subjectId.
  subjectId      String?
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  // YYYY-MM-DD in APP_TIMEZONE, same convention as Review.dueDate.
  nextReviewDate String
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tags FlashcardTag[]

  @@index([userId])
  @@index([userId, nextReviewDate])
  @@index([userId, subjectId])
  @@map("flashcards")
}

model FlashcardTag {
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([flashcardId, tagId])
  @@index([tagId])
  @@map("flashcard_tags")
}
