# Dependencies
node_modules/

# Build output
dist/
build/
backend/generated/
coverage/
*.tsbuildinfo

# Env files (secrets: DB connection string, JWT secret, OAuth client
# secrets, SMTP app password all live in these)
.env
.env.*

# SSH/TLS private keys — a real ed25519 keypair ended up committed here
# by accident once (backend/ed25519*), got pushed to the public repo, and
# had to be purged from history. These patterns exist so `git add .`
# can never repeat that.
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
ed25519
ed25519.pub
*.pem
*.key

# Claude Code project config
.claude/

# Project docs / assets not meant for version control
DEPLOY.md
RETROSPECTIVA.md
TASK_100DIAS.MD.md
figma-ui.jpeg

# Logs
*.log
npm-debug.log*

# OS/editor
.DS_Store
.vscode/

# Installers/executables that have no business being in a web-served
# public/ folder — GitHub rejects pushes over 100MB, and these have shown
# up there by accident before (drag-and-drop into the wrong folder).
*.exe
*.msi
*.dmg
